{
  "name": "@goah/cli",
  "version": "0.11.5",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/billc8128/opengoah.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./kernel": "./dist/kernel.js",
    "./session": "./dist/session.js",
    "./execution": "./dist/execution.js",
    "./metrics": "./dist/metrics.js",
    "./sqlite": "./dist/sqlite.js",
    "./supervisor": "./dist/supervisor.js",
    "./runner-pi": "./dist/runner-pi.js",
    "./testkit": "./dist/testkit.js"
  },
  "bin": {
    "goah": "dist/cli.js"
  },
  "scripts": {
    "prepack": "node ../../scripts/prepare-single-package.mjs",
    "postpack": "node ../../scripts/cleanup-single-package.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-tui": "^0.84.2",
    "goah-ledger-contract": "0.6.0",
    "goah-ledger-sqlite": "0.6.0",
    "goah-runner-pi": "0.6.0",
    "goah-supervisor": "0.6.0",
    "goah-testkit": "0.6.0"
  },
  "bundledDependencies": [
    "goah-ledger-contract",
    "goah-ledger-sqlite",
    "goah-runner-pi",
    "goah-supervisor",
    "goah-testkit"
  ],
  "bundleDependencies": [
    "goah-ledger-contract",
    "goah-ledger-sqlite",
    "goah-runner-pi",
    "goah-supervisor",
    "goah-testkit"
  ]
}
