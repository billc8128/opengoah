{
  "name": "goah-monorepo",
  "private": true,
  "version": "0.5.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/billc8128/opengoah.git"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "clean": "node scripts/clean-build.mjs",
    "build": "npm run clean && tsc -b && npm run console:build",
    "typecheck": "tsc -b --pretty false",
    "test": "npm run build && node --test packages/*/dist/*.test.js",
    "test:soak": "npm run build && node --test --test-name-pattern='accelerated 30-day soak' packages/testkit/dist/index.test.js",
    "soak:real": "npm run build && node scripts/run-soak.mjs",
    "example": "npm run build && node examples/minimal/dist/index.js",
    "example:guardian": "npm run build && node examples/repo-guardian/dist/index.js",
    "pack:smoke": "npm run build && node scripts/pack-smoke.mjs",
    "web:dev": "npm run dev --workspace @goah/web",
    "web:build": "npm run build --workspace @goah/web",
    "console:dev": "npm run dev --workspace @goah/console",
    "console:build": "npm run build --workspace @goah/console && node scripts/copy-console-assets.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "rollup": "4.62.4",
    "rollup-plugin-dts": "^6.5.1",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
